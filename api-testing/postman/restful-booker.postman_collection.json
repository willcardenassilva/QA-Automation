                  "pm.test(\"firstname Ana\", () => pm.expect(pm.response.json().firstname).to.eql(\"Ana\"));",
                  "pm.test(\"Responde en menos de 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
